# Copy to .env (git-ignored) and fill in. Never commit real values.
# Read by ppe/alerts/config.py.

# Twilio account. Phone numbers in E.164 format, e.g. +14155550100
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ALERT_RECIPIENT_PHONE=

# Alerts are off unless this is true
ENABLE_TWILIO_ALERTS=false
ALERT_SMS_ENABLED=true
ALERT_CALL_ENABLED=false
SMS_COOLDOWN_SECONDS=60
DAILY_SMS_LIMIT=100
CALL_ONLY_CRITICAL=true
CRITICAL_VIOLATION_THRESHOLD=3
ALERT_LOCATION=Workplace

# Deduplication
ALERT_COOLDOWN_SECONDS=30
ENABLE_DEDUPLICATION=true
MAX_VIOLATION_HISTORY=100
